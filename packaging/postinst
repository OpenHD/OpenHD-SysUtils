#!/bin/sh

set -e

case "$1" in
    configure|triggered)
        if [ -x /usr/local/sbin/openhd-silent-boot-setup ]; then
            /usr/local/sbin/openhd-silent-boot-setup || true
        fi

        # The X20 package carries the legacy launcher. Preserve the platform
        # markers consumed by OpenHD's X20 and RTL8812AU detection paths.
        if [ -x /usr/local/bin/x20/OpenHD_X20 ]; then
            mkdir -p /usr/local/share/openhd_platform/x20
            mkdir -p /usr/local/share/openhd_platform/wifi_card_type/88xxau
            touch /usr/local/share/openhd_platform/x20/hdzero
            touch /usr/local/share/openhd_platform/wifi_card_type/88xxau/custom
        fi

        if [ -d /run/systemd/system ]; then
            # Retire the pre-C++ launcher. Old images can leave this enabled,
            # but the shell script it points at no longer ships.
            systemctl disable --now openhd_sys_utils.service >/dev/null 2>&1 || true
            rm -f /etc/systemd/system/openhd_sys_utils.service
            rm -f /etc/init.d/openhd-sys-utils
            systemctl daemon-reload || true
            systemctl enable openhd-sys-utils.service >/dev/null 2>&1 || true
            systemctl restart openhd-sys-utils.service >/dev/null 2>&1 || true
        fi
        ;;
esac

exit 0
