#!/bin/sh

set -e

case "$1" in
    configure|triggered)
        if [ -x /usr/local/sbin/openhd-silent-boot-setup ]; then
            /usr/local/sbin/openhd-silent-boot-setup || true
        fi

        # The X20 package carries the legacy launcher. Preserve the platform
        # markers consumed by OpenHD's X20 and RTL8812AU detection paths.
        if [ -x /usr/local/bin/x20/OpenHD_X20 ]; then
            mkdir -p /usr/local/share/openhd_platform/x20
            mkdir -p /usr/local/share/openhd_platform/wifi_card_type/88xxau
            touch /usr/local/share/openhd_platform/x20/hdzero
            touch /usr/local/share/openhd_platform/wifi_card_type/88xxau/custom
        fi

        # Retire the pre-C++ launcher. Old images can leave this enabled, but
        # the shell script it points at no longer ships.
        if command -v systemctl >/dev/null 2>&1; then
            systemctl disable openhd_sys_utils.service >/dev/null 2>&1 || true
        fi
        rm -f /etc/systemd/system/openhd_sys_utils.service

        # X20 uses this SysV entry on older images. It launches the compiled
        # /usr/local/bin/openhd_sys_utils daemon, not the retired shell utility.
        if [ -x /etc/init.d/openhd-sys-utils ]; then
            if command -v update-rc.d >/dev/null 2>&1; then
                update-rc.d openhd-sys-utils defaults
            fi

            if [ ! -d /run/systemd/system ]; then
                if command -v invoke-rc.d >/dev/null 2>&1; then
                    invoke-rc.d openhd-sys-utils start || true
                else
                    /etc/init.d/openhd-sys-utils start || true
                fi
            fi
        fi

        if command -v systemctl >/dev/null 2>&1; then
            # Enabling a unit does not require a running systemd instance. Do
            # this even in an image-building chroot so the compiled SysUtils
            # daemon is started on the X20's first real boot.
            systemctl enable openhd-sys-utils.service >/dev/null 2>&1 || true

            if [ -d /run/systemd/system ]; then
                systemctl stop openhd_sys_utils.service >/dev/null 2>&1 || true
                systemctl daemon-reload || true
                systemctl restart openhd-sys-utils.service >/dev/null 2>&1 || true
            fi
        fi
        ;;
esac

exit 0
