# Startup and periodic polling must never provision storage.
foreach(entry src/openhd_sys_utils.cpp src/sysutil_firstboot.cpp)
    file(READ "${SOURCE_ROOT}/${entry}" contents)
    if(contents MATCHES "(resize_partition_firstboot|prepare_recording_sd|repartition_disk|format_partition|create_recording_partition)[ \t\r\n]*\\(")
        message(FATAL_ERROR "Automatic storage mutation returned in ${entry}")
    endif()
    if(contents MATCHES "(mkfs|sfdisk|resize2fs|growpart|ubiformat)")
        message(FATAL_ERROR "Storage command returned in ${entry}")
    endif()
endforeach()
foreach(entry src/sysutil_part.cpp inc/sysutil_part.h src/sysutil_storage.cpp inc/sysutil_storage.h)
    if(EXISTS "${SOURCE_ROOT}/${entry}")
        file(READ "${SOURCE_ROOT}/${entry}" contents)
        if(contents MATCHES "(resize_partition_firstboot|prepare_recording_sd|stop_recording_sd_probe|g_blank_card_probe)")
            message(FATAL_ERROR "Automatic provisioning implementation returned in ${entry}")
        endif()
    endif()
endforeach()
message(STATUS "Startup and periodic storage provisioning remain disabled")
